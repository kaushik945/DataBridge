POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+psycopg://databridge:local-development-only@db:5432/databridge
AI_MODE=mock
LOCAL_ENDPOINT=http://host.docker.internal:11434
LOCAL_MODEL=qwen3:4b
LOCAL_EMBEDDING_MODEL=nomic-embed-text:v1.5
LOCAL_CONTEXT=4096
LOCAL_TIMEOUT_SECONDS=120
LOCAL_OUTPUT_TOKENS=1400
LOCAL_REVIEWER=false
INSTALL_VERTEX=false
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173
MAX_UPLOAD_BYTES=5242880
MAX_ROWS=10000
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=768
MODEL_TIMEOUT_SECONDS=45
# Optional: dated USD per million tokens, explicitly supplied by operator.
PRICING_DATE=
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
# Optional private Cloud Storage original-file archive (requires cloud dependencies/ADC).
GCS_BUCKET=
